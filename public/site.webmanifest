{
  "name": "iso-engine",
  "short_name": "iso-engine",
  "description": "轻量级 2.5D 等距 SVG 引擎：圆角盒、圆柱、锚点与连线，无需 Canvas / WebGL。",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0e0e1c",
  "theme_color": "#0e0e1c",
  "lang": "zh-CN",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
